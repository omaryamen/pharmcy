# ======================================================================
# PharmaCloud ERP — Environment Variables
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit the real `.env` file.
# ======================================================================

# ----------------------------------------------------------------------
# Django core
# ----------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=UTC
LOG_LEVEL=DEBUG

# ----------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------
DATABASE_URL=postgres://pharmacloud:pharmacloud@db:5432/pharmacloud
DATABASE_CONN_MAX_AGE=60

# ----------------------------------------------------------------------
# Redis / Cache
# ----------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------
# Celery
# ----------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# ----------------------------------------------------------------------
# CORS (frontend origins)
# ----------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# ----------------------------------------------------------------------
# JWT (SimpleJWT)
# ----------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ----------------------------------------------------------------------
# Email
# ----------------------------------------------------------------------
# Development uses the console backend by default (set below).
DEFAULT_FROM_EMAIL=no-reply@pharmacloud.local
SERVER_EMAIL=errors@pharmacloud.local
# SMTP settings for production (uncomment):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=change-me

# ----------------------------------------------------------------------
# Object storage (S3 / MinIO)
# ----------------------------------------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=pharmacloud
AWS_SECRET_ACCESS_KEY=pharmacloud-secret
AWS_STORAGE_BUCKET_NAME=pharmacloud-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4

# ----------------------------------------------------------------------
# MinIO server (docker-compose only)
# ----------------------------------------------------------------------
MINIO_ROOT_USER=pharmacloud
MINIO_ROOT_PASSWORD=pharmacloud-secret
MINIO_ENDPOINT=minio:9000

# ----------------------------------------------------------------------
# Sentry (production only)
# ----------------------------------------------------------------------
SENTRY_DSN=


